# Coregateway
# Runtime: pooler host, DML-only role. No search_path/options params needed —
# schema scoping comes from ALTER ROLE coregateway_role SET search_path
# (see internal/db/bootstrap.sql). Pooler endpoints strip `options`, so
# per-connection scoping params would be silently dropped here.
#
# NOTE: DATABASE_URL - pooled (with *-pooler, and has corefinance_role created by bootstrap, no search_path)
DATABASE_URL=postgresql://coregateway_role:pass@<pooler-host>/coredb?sslmode=require

# Migrations (goose CLI only): direct host, owner role, options form.
# A bare &search_path=... param does NOT work (libpq rejects unknown URI
# params; session silently lands in public).
#
# NOTE: MIGRATION_URL should be a direct connection because of options param (no *-pooler, pgbouncer drops this)
# below is similar to: "psql <URL> -c search_path=<schema>"
MIGRATION_URL=postgresql://neondb_owner:pass@<direct-host>/coredb?sslmode=require&channel_binding=require&options=-c%20search_path%3Dcoregateway

ADMIN_EMAIL=
ADMIN_PASSWORD=

PORT=8080
ENV=dev-or-prod
ALLOWED_ORIGINS=http://localhost:3000
