{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ejsadiarin/coregateway/main/schemas/account.v1.json",
  "title": "coregateway account part, version 1",
  "description": "Who an export belongs to, for reference (coregateway ADR-0008). Export-only: importing it changes nothing. It holds no credentials.",
  "type": "object",
  "required": ["format", "version", "exported_at", "data"],
  "properties": {
    "$schema": { "type": "string" },
    "format": { "const": "coregateway.account" },
    "version": { "const": 1 },
    "exported_at": { "type": "string", "format": "date-time" },
    "source": { "type": "object", "properties": { "service": { "type": "string" } } },
    "data": {
      "type": "object",
      "required": ["id", "email", "role", "timezone"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "email": { "type": "string" },
        "role": { "enum": ["admin", "user", "guest"] },
        "timezone": { "type": "string", "description": "The IANA zone every service reads this user's times in." },
        "created_at": { "type": "string" }
      }
    }
  }
}
