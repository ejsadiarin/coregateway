# Rendered at container start by the nginx image's envsubst step (see
# web/Dockerfile). Only variables defined in the environment are replaced,
# so nginx's own lowercase $variables pass through untouched.
#
# The gateway is looked up per request (re-resolved every 10s), not once at
# startup: a recreated gateway container gets a new IP, and a startup-only
# lookup kept proxying to the old one (502) until nginx restarted. It also
# means nginx starts even when the gateway name doesn't resolve yet.
# NGINX_LOCAL_RESOLVERS comes from /etc/resolv.conf. nginx's resolver skips
# resolv.conf search domains, so GATEWAY_UPSTREAM must be resolvable as
# written: fine for a compose service name; in k3s use the Service's FQDN.
resolver ${NGINX_LOCAL_RESOLVERS} valid=10s ipv6=off;

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Everything (incl. /api/budget/) → coregateway: only it can mint the
    # internal JWT corefinance requires, so budget calls must NOT bypass it.
    location /api/ {
        # A variable makes nginx resolve at request time. With no URI part,
        # the original request URI is passed through unchanged.
        set $gateway http://${GATEWAY_UPSTREAM};
        proxy_pass $gateway;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Imports (ADR-0008) take a JSON file up to 25 MB, or a zip with its
    # photos and videos up to 10 GB; the gateway and services cap each
    # themselves. nginx's default of 1 MB would refuse a real one before
    # the gateway saw it. The body streams through rather than being
    # buffered to disk here first, and a long upload isn't cut short.
    location ~ ^/api/(budget/|coreban/|coredraw/)?import$ {
        client_max_body_size 10g;
        proxy_request_buffering off;
        proxy_read_timeout 2h;
        proxy_send_timeout 2h;
        set $gateway http://${GATEWAY_UPSTREAM};
        proxy_pass $gateway;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # A full export with media (?media=true) is a zip streamed as each file
    # arrives: passed on as it comes, and not cut short while it runs.
    location = /api/export {
        proxy_buffering off;
        proxy_read_timeout 2h;
        proxy_send_timeout 2h;
        set $gateway http://${GATEWAY_UPSTREAM};
        proxy_pass $gateway;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # A share from another app is a POST the service worker takes (sw.js).
    # Without one yet (just installed, or its site data cleared) it reaches
    # here: open the share page, which asks for the share again, instead
    # of answering 405.
    location = /share {
        absolute_redirect off;
        if ($request_method = POST) {
            return 303 /share?failed=no-worker;
        }
        try_files /index.html =404;
    }

    # SPA fallback. The shell, worker and manifest must revalidate on every
    # load, or a phone keeps running the old build after a deploy.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
    }

    location = /sw.js {
        add_header Cache-Control "no-cache";
    }

    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache";
    }

    # Cache static assets
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
